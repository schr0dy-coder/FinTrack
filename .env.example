# ==============================================================================
# FinTrack - Environment Configuration Example
# Copy this file to .env and configure local development/production values.
# Do NOT commit .env to version control.
# ==============================================================================

# Database Connection URL
# SQLite (Local Development):
DATABASE_URL=sqlite:///./fintrack.db
# PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+psycopg://fintrack:password@localhost:5432/fintrack

# Security & Authentication (Replace with secure random key in production)
JWT_SECRET_KEY=replace-with-a-random-development-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Risk Engine Thresholds
HIGH_AMOUNT_THRESHOLD=50000.0
RAPID_TRANSACTION_WINDOW_SECONDS=120
RAPID_TRANSACTION_COUNT=5
FAILED_ATTEMPT_WINDOW_SECONDS=300
FAILED_ATTEMPT_COUNT=3

# Risk Classification Thresholds
RISK_HIGH_THRESHOLD=60.0
RISK_CRITICAL_THRESHOLD=80.0

# Risk Scoring Weights (RULE_WEIGHT + ML_WEIGHT = 1.0)
RULE_WEIGHT=0.60
ML_WEIGHT=0.40

# ML Artifact Paths
ML_MODEL_PATH=models/artifacts/isolation_forest.joblib
ML_METADATA_PATH=models/artifacts/model_metadata.json

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Dashboard Settings
API_BASE_URL=http://localhost:8000
